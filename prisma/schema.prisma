
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  profile      StudentProfile?

  @@map("users")
}

model StudentProfile {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  fullName     String         @map("full_name") @db.VarChar(150)
  bio          String?        @db.VarChar(1000)
  location     String?        @db.VarChar(150)
  contactEmail String?        @map("contact_email") @db.VarChar(255)
  githubUrl    String?        @map("github_url") @db.VarChar(2048)
  portfolioUrl String?        @map("portfolio_url") @db.VarChar(2048)
  isPublic     Boolean        @default(false) @map("is_public")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       StudentSkill[]
  projects     Project[]

  @@map("student_profiles")
}

model Skill {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique @db.VarChar(100)

  students  StudentSkill[]

  @@map("skills")
}

model StudentSkill {
  studentProfileId String         @map("student_profile_id") @db.Uuid
  skillId          String         @map("skill_id") @db.Uuid

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, skillId])
  @@map("student_skills")
}

model Project {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @map("student_profile_id") @db.Uuid
  title            String         @db.VarChar(150)
  description      String?        @db.VarChar(2000)
  githubUrl        String?        @map("github_url") @db.VarChar(2048)
  demoUrl          String?        @map("demo_url") @db.VarChar(2048)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("projects")
}
