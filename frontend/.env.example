# Base URL the browser uses for API calls. Keep the default "/api" to use the
# Vite dev/preview proxy (no backend CORS needed). An absolute URL such as
# http://localhost:3000/api only works if the backend allows that origin.
VITE_API_BASE_URL=/api

# Where the Vite dev/preview proxy forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:3000
