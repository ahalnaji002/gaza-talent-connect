# Placeholders only. Never commit real values; set production values in the
# hosting provider's environment settings.

# Leave unset (or "development") locally. Set to "production" when deployed:
# production enables strict CORS, JWT and Swagger rules.
# NODE_ENV=production

# Local development database; replace the password with your local PostgreSQL password.
# In production use the provider's URL with sslmode=verify-full.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/gaza_talent_connect?schema=public"

# Private random signing secret. Production requires at least 32 characters and
# rejects this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_PRIVATE_RANDOM_SECRET"

# Optional; defaults to 3000. Hosting providers usually set it.
PORT=3000

# Comma-separated exact frontend origins allowed to call the API (no paths, no
# wildcards). Required in production and must use https there. When unset
# outside production, the local Vite origins (localhost/127.0.0.1 on ports 5173
# and 4173) are allowed.
# CORS_ORIGIN=https://your-frontend.example.com

# Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json). Defaults to true
# locally and false in production; set "true" to expose them in production.
# SWAGGER_ENABLED=false

# Trusted client-IP header for rate limiting. Leave unset locally and on any
# server that clients can reach directly; the TCP peer address is then used.
# On a public Render web service set it to cf-connecting-ip (the only supported
# value): Cloudflare overwrites that header on every request. It is accepted
# only with NODE_ENV=production and RENDER=true (Render sets RENDER itself);
# otherwise startup fails. X-Forwarded-For and True-Client-IP are rejected
# because clients can control them. RENDER=true is a configuration guard, not
# proof of the proxy chain: never enable this on a directly reachable server.
# CLIENT_IP_HEADER=cf-connecting-ip

# E2E runner input. Export this in the shell before npm run test:e2e.
# The runner accepts only the gaza_talent_connect_test database.
TEST_DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/gaza_talent_connect_test?schema=public"

# Optional seed safety confirmation. Set only for the single manual seed run,
# using the exact target database name, then unset it.
# SKILLS_SEED_CONFIRM_DATABASE=
